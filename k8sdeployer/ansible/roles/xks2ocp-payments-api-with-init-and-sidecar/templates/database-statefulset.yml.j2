apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: {{ database_app_name }}
  namespace: {{ namespace }}
  labels:
    app: {{ database_app_name }}
spec:
  serviceName: {{ database_app_name }}
  replicas: 1
  selector:
    matchLabels:
      app: {{ database_app_name }}
  template:
    metadata:
      labels:
        app: {{ database_app_name }}
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
{% if not (is_openshift | default(false) | bool) %}
        # Azure Disk volumes are root-owned when first mounted. The xKS source
        # needs the PostgreSQL image's root group to initialize its data dir.
        # The xKS-to-OCP transform must remove this source-only value so the
        # target SCC can assign an allowed fsGroup.
        fsGroup: 0
        fsGroupChangePolicy: OnRootMismatch
{% endif %}
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: postgresql
          image: {{ postgres_image }}
          ports:
            - name: postgresql
              containerPort: 5432
          env:
            - name: POSTGRESQL_DATABASE
              valueFrom:
                secretKeyRef:
                  name: {{ app_name }}
                  key: database
            - name: POSTGRESQL_USER
              valueFrom:
                secretKeyRef:
                  name: {{ app_name }}
                  key: username
            - name: POSTGRESQL_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: {{ app_name }}
                  key: password
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          readinessProbe:
            exec:
              command:
                - /bin/sh
                - -ec
                - pg_isready -U "$POSTGRESQL_USER" -d "$POSTGRESQL_DATABASE"
            initialDelaySeconds: 10
            periodSeconds: 5
          livenessProbe:
            exec:
              command:
                - /bin/sh
                - -ec
                - pg_isready -U "$POSTGRESQL_USER" -d "$POSTGRESQL_DATABASE"
            initialDelaySeconds: 30
            periodSeconds: 10
          volumeMounts:
            - name: data
              mountPath: /var/lib/pgsql/data
  volumeClaimTemplates:
    - metadata:
        name: data
        labels:
          app: {{ database_app_name }}
      spec:
        accessModes:
          - {{ access_mode }}
{% if storage_class | length > 0 %}
        storageClassName: {{ storage_class }}
{% endif %}
        resources:
          requests:
            storage: {{ storage_size }}
